# Copy to .env and fill in. Do NOT commit a real .env.
# ---------------------------------------------------------------------------

# Which settings module to load. Local dev: config.settings.dev
# Production (Render/Docker): config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated. In dev you can leave empty; in prod set your domain(s).
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production reads a single DATABASE_URL (managed Postgres).
DATABASE_URL=postgres://vbb:vbb_pass@db:5432/vbb_db
# The local docker-compose Postgres service also reads these:
POSTGRES_USER=vbb
POSTGRES_PASSWORD=vbb_pass
POSTGRES_DB=vbb_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Production security (config.settings.prod) — optional overrides
# ---------------------------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# SECURE_SSL_REDIRECT=True
# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Email (production) — defaults to console backend if unset
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Virtual Blood Bank <no-reply@example.com>

# ---------------------------------------------------------------------------
# Frontend origin (used for allauth email/redirect links)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# CORS (web client) — comma-separated origins, no trailing slash
# ---------------------------------------------------------------------------
# Dev defaults to the Vite dev server (http://localhost:5173) if unset.
# In prod set your deployed web client origin(s). Never use a wildcard.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# API throttling (DRF) — optional overrides, format "<n>/<period>"
# ---------------------------------------------------------------------------
# THROTTLE_ANON_RATE=60/min
# THROTTLE_USER_RATE=240/min
# THROTTLE_AUTH_RATE=10/min

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Comma-separated adapter list: "stdout", "fcm" (alias "push"). Unknown names
# fall back to stdout. Default: stdout.
# NOTIFICATION_ADAPTERS=stdout,fcm
# Path to the Firebase service-account JSON for FCM push. Either variable
# works; GOOGLE_APPLICATION_CREDENTIALS is the standard Google SDK name.
# Without credentials FCM delivery is simulated (logged only).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# ---------------------------------------------------------------------------
# Domain configuration (see docs/CONTEXT.md) — optional overrides
# ---------------------------------------------------------------------------
# INVENTORY_LOW_STOCK_THRESHOLD=5
# INVENTORY_STANDARD_EXPIRY_DAYS=42
# FACILITY_WOREDA_MAX=20
# API_PAGE_SIZE=25

# ---------------------------------------------------------------------------
# Social auth providers (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
